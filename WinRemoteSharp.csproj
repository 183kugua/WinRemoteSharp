<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WinRemoteSharp</RootNamespace>
    <AssemblyName>WinRemoteAgent</AssemblyName>
    <Version>1.2.0</Version>
    <Product>WinRemote Agent</Product>
    <Company>WinRemote</Company>
    <Copyright>AGPL-3.0</Copyright>
    <Description>WinRemote 远程控制代理 - 薄荷清新版 V1.2</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType>embedded</DebugType>
    <ErrorReport>prompt</ErrorReport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="App.xaml.cs" />
    <Compile Include="MainWindow.xaml.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="ConfigManager.cs" />
    <Compile Include="AgentClient.cs" />
    <Compile Include="ServiceManager.cs" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="App.xaml" />
    <Page Include="MainWindow.xaml" />
  </ItemGroup>

</Project>
