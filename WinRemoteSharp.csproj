<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>WinRemoteSharp</RootNamespace>
    <AssemblyName>WinRemoteAgent</AssemblyName>
    <ApplicationIcon>Resources\App.ico</ApplicationIcon>

    <!-- Single-file self-contained publish -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Language -->
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Assembly metadata -->
    <AssemblyTitle>WinRemote Agent</AssemblyTitle>
    <AssemblyDescription>WinRemote C# WPF Agent - Remote Control via AstrBot</AssemblyDescription>
    <AssemblyCompany>WinRemote</AssemblyCompany>
    <AssemblyProduct>WinRemoteAgent</AssemblyProduct>
    <AssemblyCopyright>Copyright (c) 2026</AssemblyCopyright>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultResourceItems>false</EnableDefaultResourceItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Root directory source files -->
    <Compile Include="Program.cs" />
    <Compile Include="App.xaml.cs" />
    <Compile Include="MainWindow.xaml.cs" />
    <Compile Include="InputDialog.cs" />
    <Compile Include="ConfigManager.cs" />
    <Compile Include="TrayManager.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core/ source files -->
    <Compile Include="Core\AgentClient.cs" />
    <Compile Include="Core\AgentConfig.cs" />
    <Compile Include="Core\ServiceManager.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- XAML pages -->
    <Page Include="App.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Include="MainWindow.xaml">
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <!-- Config files copied to output -->
    <None Include="App.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="app.manifest">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- 窗口图标使用 WPF Resource -->
    <Resource Include="Resources\App.ico" />
    <!-- 托盘图标使用 EmbeddedResource -->
    <EmbeddedResource Include="Resources\DialogIcon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- System.Drawing.Common for .NET 8 -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

</Project>
