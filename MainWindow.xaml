<Window x:Class="WinRemoteSharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinRemote 远程控制代理 V1.2"
        Width="900" Height="650"
        MinWidth="800" MinHeight="550"
        Background="{StaticResource MintWhiteBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- ========== 标题栏 ========== -->
        <Border Grid.Row="0" Background="{StaticResource TitleBarBrush}">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F6E1; WinRemote" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="远程控制代理" FontSize="14" Foreground="#CCFFFFFF" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="{StaticResource ErrorBrush}" Margin="0,0,8,0">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard Storyboard="{StaticResource StatusDotPulse}"/>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock x:Name="StatusText" Text="Agent 已停止" FontSize="13" Foreground="White"/>
                    <TextBlock Text="|" Foreground="#88FFFFFF" Margin="12,0"/>
                    <TextBlock Text="V1.2 中文版" FontSize="12" Foreground="#CCFFFFFF"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== 主内容 TabControl ========== -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="16,12,16,8" FontSize="13">

            <!-- ===== 主控台 ===== -->
            <TabItem Header="&#x1F3E0; 主控台">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <GroupBox Header="连接状态">
                            <StackPanel>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="服务器地址：" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="TxtServerUrl" Text="ws://127.0.0.1:6190/winremote"/>
                                </Grid>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="认证 Token：" VerticalAlignment="Center"/>
                                    <PasswordBox Grid.Column="1" x:Name="TxtToken"/>
                                </Grid>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Agent ID：" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="TxtAgentId" IsReadOnly="True" Background="#FFF0F0F0"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="BtnConnect" Content="&#x1F517; 连接服务器" Width="150" Height="36" Click="BtnConnect_Click"/>
                                    <Button x:Name="BtnDisconnect" Content="&#x1F6D1; 断开连接" Width="150" Height="36" Style="{StaticResource DangerButton}" Margin="12,0,0,0" Click="BtnDisconnect_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="快速操作">
                            <WrapPanel>
                                <Button Content="&#x1F4CB; 执行命令" Width="130" Height="34" Margin="4" Click="BtnShell_Click"/>
                                <Button Content="&#x1F4BB; PowerShell" Width="130" Height="34" Margin="4" Click="BtnPowershell_Click"/>
                                <Button Content="&#x1F4F7; 截图" Width="100" Height="34" Margin="4" Click="BtnScreenshot_Click"/>
                                <Button Content="&#x2328; 模拟按键" Width="120" Height="34" Margin="4" Click="BtnKeypress_Click"/>
                                <Button Content="&#x1F42D; 鼠标操作" Width="120" Height="34" Margin="4" Click="BtnMouse_Click"/>
                                <Button Content="&#x1F4C2; 打开程序" Width="120" Height="34" Margin="4" Click="BtnOpen_Click"/>
                                <Button Content="&#x1F4DD; 读文件" Width="100" Height="34" Margin="4" Click="BtnReadFile_Click"/>
                                <Button Content="&#x270F; 写文件" Width="100" Height="34" Margin="4" Click="BtnWriteFile_Click"/>
                            </WrapPanel>
                        </GroupBox>

                        <GroupBox Header="实时日志">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBox Grid.Row="0" x:Name="TxtLog" Height="160" IsReadOnly="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" FontSize="12" Background="#FF1E1E1E" Foreground="#FF4AF626"/>
                                <Button Grid.Row="1" Content="清空日志" Width="100" Height="28" Margin="0,6,0,0" HorizontalAlignment="Right" Click="BtnClearLog_Click"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== 设置 ===== -->
            <TabItem Header="&#x2699; 设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <GroupBox Header="常规设置">
                            <StackPanel>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="心跳间隔（秒）：" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="TxtHeartbeat" Width="100" HorizontalAlignment="Left"/>
                                </Grid>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Shell 超时（秒）：" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="TxtShellTimeout" Width="100" HorizontalAlignment="Left"/>
                                </Grid>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="最大输出字节数：" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="TxtMaxOutput" Width="120" HorizontalAlignment="Left"/>
                                </Grid>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="截图格式：" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="CmbScreenshotFmt" Width="120" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="JPEG"/>
                                        <ComboBoxItem Content="PNG"/>
                                        <ComboBoxItem Content="WEBP"/>
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="截图质量（1-100）：" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="TxtScreenshotQuality" Width="80" HorizontalAlignment="Left"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="安全设置">
                            <StackPanel>
                                <CheckBox x:Name="ChkAllowPowershell" Content="允许 PowerShell 指令"/>
                                <CheckBox x:Name="ChkAllowWrite" Content="允许文件写入"/>
                                <CheckBox x:Name="ChkAutoReconnect" Content="断线自动重连"/>
                                <CheckBox x:Name="ChkStrictWhitelist" Content="严格路径白名单模式"/>
                                <CheckBox x:Name="ChkPasswordGuard" Content="启用二次密码验证"/>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="二次密码：" VerticalAlignment="Center"/>
                                    <PasswordBox Grid.Column="1" x:Name="TxtPasswordGuard"/>
                                </Grid>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="最大文件读取字节：" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="TxtMaxReadBytes" Width="120" HorizontalAlignment="Left"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="路径白名单">
                            <StackPanel>
                                <TextBlock Text="允许访问的目录（每行一个）：" Margin="0,4"/>
                                <TextBox x:Name="TxtWhitelist" Height="70" TextWrapping="Wrap" AcceptsReturn="True" FontFamily="Consolas"/>
                                <TextBlock Text="禁用关键词（每行一个）：" Margin="8,8,0,4"/>
                                <TextBox x:Name="TxtBlacklist" Height="50" TextWrapping="Wrap" AcceptsReturn="True" FontFamily="Consolas"/>
                            </StackPanel>
                        </GroupBox>

                        <Button Content="&#x1F4BE; 保存配置" Width="160" Height="36" HorizontalAlignment="Left" Margin="0,12,0,0" Click="BtnSaveConfig_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== 系统服务 ===== -->
            <TabItem Header="&#x1F527; 系统服务">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <GroupBox Header="NSSM 服务管理">
                            <StackPanel>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="服务状态：" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Ellipse x:Name="ServiceDot" Width="10" Height="10" Fill="{StaticResource TextMutedBrush}" Margin="0,0,8,0">
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                    <BeginStoryboard Storyboard="{StaticResource StatusDotPulse}"/>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                        <TextBlock x:Name="ServiceStatusText" Text="未知" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,10">
                                    <Button Content="&#x25B6; 启动服务" Width="120" Height="34" Click="BtnSvcStart_Click"/>
                                    <Button Content="&#x23F9; 停止服务" Width="120" Height="34" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="BtnSvcStop_Click"/>
                                    <Button Content="&#x1F504; 重启服务" Width="120" Height="34" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BtnSvcRestart_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="&#x2B07; 安装服务" Width="120" Height="34" Click="BtnSvcInstall_Click"/>
                                    <Button Content="&#x274C; 卸载服务" Width="120" Height="34" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="BtnSvcUninstall_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="NSSM 工具">
                            <StackPanel>
                                <TextBlock x:Name="NssmStatusText" Text="NSSM 状态：检测中..." Margin="0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8">
                                    <Button Content="&#x2B07; 下载 NSSM" Width="140" Height="34" Click="BtnDownloadNssm_Click"/>
                                    <Button Content="查看日志" Width="120" Height="34" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BtnViewLogs_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="服务日志">
                            <TextBox x:Name="TxtServiceLog" Height="150" IsReadOnly="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" FontSize="11" Background="#FFF8F8F8"/>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== 运行日志 ===== -->
            <TabItem Header="&#x1F4CB; 运行日志">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="刷新" Width="80" Height="30" Click="BtnRefreshLog_Click"/>
                        <Button Content="清空" Width="80" Height="30" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="BtnClearServiceLog_Click"/>
                        <TextBlock x:Name="LogStatusText" Text="" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                    <TextBox Grid.Row="1" x:Name="TxtFullLog" IsReadOnly="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12" Background="#FF1E1E1E" Foreground="#FF4AF626"/>
                </Grid>
            </TabItem>

            <!-- ===== 工具箱 ===== -->
            <TabItem Header="&#x1F6E0; 工具箱">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <GroupBox Header="系统信息">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="主机名：" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtHostname"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="用户名：" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtUsername"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="操作系统：" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtOS"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text=".NET 版本：" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtDotNetVer"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="测试工具">
                            <StackPanel>
                                <TextBlock Text="发送测试指令到服务器：" Margin="0,4"/>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="指令：" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="TxtTestCommand" Text="ipconfig"/>
                                    <Button Grid.Column="2" Content="发送" Width="80" Height="30" Margin="8,0,0,0" Click="BtnSendTest_Click"/>
                                </Grid>
                                <TextBlock Text="测试结果：" Margin="8,8,0,4"/>
                                <TextBox x:Name="TxtTestResult" Height="100" IsReadOnly="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" FontSize="11" Background="#FFF8F8F8"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="关于">
                            <StackPanel>
                                <TextBlock Text="WinRemote Agent V1.2 - C# WPF 中文版" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="与 AstrBot astrbot_plugin_winremote 协议兼容" Margin="0,4,0,0"/>
                                <TextBlock Text="License: AGPL-3.0" Margin="0,2,0,0"/>
                                <TextBlock Text="零 NuGet 依赖 - 纯 .NET 8 BCL + WPF" Margin="0,2,0,0"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- ========== 底部状态栏 ========== -->
        <Border Grid.Row="2" Background="{StaticResource SkyMainBrush}">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatusMessage" Text="就绪" VerticalAlignment="Center" Foreground="White" FontSize="12"/>
                <TextBlock Grid.Column="1" Text="AGPL-3.0 Licensed" VerticalAlignment="Center" Foreground="#CCFFFFFF" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>
