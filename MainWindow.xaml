<Window x:Class="WinRemoteSharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinRemote Agent"
        Width="900" Height="680"
        MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{StaticResource TitleBarBrush}" Padding="16,10">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F6E1;" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="WinRemote Agent"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextLightBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="V1.2"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="Red" Margin="0,0,6,0"/>
                    <TextBlock x:Name="StatusText" Text="Agent 已停止"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 标签页区域 -->
        <TabControl Grid.Row="1" Margin="12,10,12,0">
            <!-- ===== 主控台 ===== -->
            <TabItem Header="主控台">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,8,8,16">
                        <!-- 服务器连接 -->
                        <GroupBox Header="服务器连接">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="服务器地址" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox x:Name="TxtServerUrl" Grid.Column="1" Text="ws://127.0.0.1:8080/agent"/>

                                <TextBlock Grid.Row="1" Text="Token" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <PasswordBox x:Name="TxtToken" Grid.Row="1" Grid.Column="1"/>

                                <TextBlock Grid.Row="2" Text="Agent ID" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox x:Name="TxtAgentId" Grid.Row="2" Grid.Column="1"/>

                                <TextBlock Grid.Row="3" Text="心跳间隔" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox x:Name="TxtHeartbeat" Grid.Row="3" Grid.Column="1" Text="30" Width="80" HorizontalAlignment="Left"/>

                                <TextBlock Grid.Row="4" Text="超时" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox x:Name="TxtShellTimeout" Grid.Row="4" Grid.Column="1" Text="30" Width="80" HorizontalAlignment="Left"/>

                                <StackPanel Grid.Column="2" Grid.RowSpan="5" VerticalAlignment="Top" Margin="8,0,0,0">
                                    <Button x:Name="BtnConnect" Content="连接" Click="BtnConnect_Click" Width="90" Margin="0,0,0,6"/>
                                    <Button Content="停止" Style="{StaticResource DangerButton}" Click="BtnDisconnect_Click" Width="90" Margin="0,0,0,6"/>
                                    <Button Content="测试连接" Style="{StaticResource SecondaryButton}" Click="BtnSendTest_Click" Width="90" Margin="0,0,0,6"/>
                                    <Button Content="保存配置" Click="BtnSaveConfig_Click" Width="90"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <!-- 工具箱 -->
                        <GroupBox Header="工具箱">
                            <WrapPanel>
                                <Button Content="CMD" Click="BtnShell_Click" Width="80" Margin="0,0,8,6"/>
                                <Button Content="PowerShell" Click="BtnPowershell_Click" Width="80" Margin="0,0,8,6"/>
                                <Button Content="截图" Style="{StaticResource SecondaryButton}" Click="BtnScreenshot_Click" Width="80" Margin="0,0,8,6"/>
                                <Button Content="按键" Style="{StaticResource SecondaryButton}" Click="BtnKeypress_Click" Width="80" Margin="0,0,8,6"/>
                                <Button Content="鼠标" Style="{StaticResource SecondaryButton}" Click="BtnMouse_Click" Width="80" Margin="0,0,8,6"/>
                                <Button Content="打开" Style="{StaticResource SecondaryButton}" Click="BtnOpen_Click" Width="80" Margin="0,0,8,6"/>
                                <Button Content="读文件" Style="{StaticResource SecondaryButton}" Click="BtnReadFile_Click" Width="80" Margin="0,0,8,6"/>
                                <Button Content="写文件" Style="{StaticResource SecondaryButton}" Click="BtnWriteFile_Click" Width="80"/>
                            </WrapPanel>
                        </GroupBox>

                        <!-- 命令测试 -->
                        <GroupBox Header="命令测试">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="140"/>
                                </Grid.RowDefinitions>
                                <TextBox x:Name="TxtTestCommand" Margin="0,0,0,6"/>
                                <Button Grid.Row="1" Content="发送" Click="BtnRunTestCommand_Click" Width="80" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtTestResult" Grid.Row="2"
                                         IsReadOnly="True" TextWrapping="Wrap"
                                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         Background="{StaticResource BgCardBrush}"
                                         FontFamily="Consolas" FontSize="12"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== 设置 ===== -->
            <TabItem Header="设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,8,8,16">
                        <GroupBox Header="安全设置">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <CheckBox x:Name="ChkAllowPowershell" Content="允许 PowerShell" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ChkAllowWrite" Grid.Row="1" Content="允许写文件" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ChkAutoReconnect" Grid.Row="2" Content="自动重连" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ChkStrictWhitelist" Grid.Row="3" Content="严格白名单" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ChkPasswordGuard" Grid.Row="4" Content="密码保护" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="5" Text="文件读取白名单（每行一个路径）" Margin="0,10,0,4"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="白名单">
                            <TextBox x:Name="TxtWhitelist" Height="100" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        </GroupBox>

                        <GroupBox Header="高级选项">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="最大输出字节" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox x:Name="TxtMaxOutput" Grid.Column="1" Text="65536" Width="120" HorizontalAlignment="Left"/>

                                <TextBlock Grid.Row="1" Text="截图质量 (1-100)" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox x:Name="TxtScreenshotQuality" Grid.Row="1" Grid.Column="1" Text="80" Width="120" HorizontalAlignment="Left"/>

                                <TextBlock Grid.Row="2" Text="截图格式" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <ComboBox x:Name="CmbScreenshotFmt" Grid.Row="2" Grid.Column="1" Width="120" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="JPEG"/>
                                    <ComboBoxItem Content="PNG"/>
                                </ComboBox>

                                <TextBlock Grid.Row="3" Text="最大读文件字节" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox x:Name="TxtMaxReadBytes" Grid.Row="3" Grid.Column="1" Text="1048576" Width="120" HorizontalAlignment="Left"/>

                                <TextBlock Grid.Row="4" Text="禁止关键词" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox x:Name="TxtBlacklist" Grid.Row="4" Grid.Column="1" Width="200" HorizontalAlignment="Left"/>

                                <TextBlock Grid.Row="5" Text="保护密码" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <PasswordBox x:Name="TxtPasswordGuard" Grid.Row="5" Grid.Column="1" Width="200" HorizontalAlignment="Left"/>

                                <Button Grid.Row="6" Grid.Column="1" Content="保存设置" Click="BtnSaveConfig_Click"
                                        Width="100" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== 系统服务 ===== -->
            <TabItem Header="系统服务">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,8,8,16">
                        <GroupBox Header="服务状态">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                </Grid.RowDefinitions>

                                <Ellipse x:Name="ServiceDot" Width="10" Height="10" Fill="Gray" Margin="0,0,8,0"/>
                                <TextBlock x:Name="ServiceStatusText" Grid.Column="1" Text="未知" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="1" Text="NSSM" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NssmStatusText" Grid.Row="1" Grid.Column="1" Text="检查中..." VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="2" Text="如需安装为 Windows 服务，请先下载 NSSM" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="服务操作">
                            <WrapPanel>
                                <Button Content="安装服务" Click="BtnSvcInstall_Click" Width="90" Margin="0,0,8,6"/>
                                <Button Content="卸载服务" Style="{StaticResource DangerButton}" Click="BtnSvcUninstall_Click" Width="90" Margin="0,0,8,6"/>
                                <Button Content="启动" Click="BtnSvcStart_Click" Width="70" Margin="0,0,8,6"/>
                                <Button Content="停止" Style="{StaticResource SecondaryButton}" Click="BtnSvcStop_Click" Width="70" Margin="0,0,8,6"/>
                                <Button Content="重启" Style="{StaticResource SecondaryButton}" Click="BtnSvcRestart_Click" Width="70" Margin="0,0,8,6"/>
                                <Button Content="下载 NSSM" Click="BtnDownloadNssm_Click" Width="90"/>
                            </WrapPanel>
                        </GroupBox>

                        <GroupBox Header="服务日志">
                            <StackPanel>
                                <TextBox x:Name="TxtServiceLog" Height="120"
                                         IsReadOnly="True" TextWrapping="Wrap"
                                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         Background="{StaticResource BgCardBrush}"
                                         FontFamily="Consolas" FontSize="12"/>
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Content="刷新日志" Style="{StaticResource SecondaryButton}"
                                            Click="BtnViewLogs_Click" Width="80" Margin="0,0,8,0"
                                            FontSize="11" Padding="6,4"/>
                                    <Button Content="清除" Style="{StaticResource SecondaryButton}"
                                            Click="BtnClearServiceLog_Click" Width="50"
                                            FontSize="11" Padding="6,4"/>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== 运行日志 ===== -->
            <TabItem Header="运行日志">
                <Grid Margin="8,8,8,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="完整日志" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="刷新" Style="{StaticResource SecondaryButton}"
                                Click="BtnRefreshLog_Click" Width="50" Margin="0,0,6,0"
                                FontSize="11" Padding="6,4"/>
                        <Button Content="清除" Style="{StaticResource SecondaryButton}"
                                Click="BtnClearLog_Click" Width="50"
                                FontSize="11" Padding="6,4"/>
                    </StackPanel>
                    <TextBox x:Name="TxtFullLog" Grid.Row="1" Grid.ColumnSpan="2"
                             IsReadOnly="True" TextWrapping="Wrap"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             Background="{StaticResource BgCardBrush}"
                             FontFamily="Consolas" FontSize="12"/>
                </Grid>
            </TabItem>

            <!-- ===== 工具箱 ===== -->
            <TabItem Header="工具箱">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,8,8,16">
                        <GroupBox Header="系统信息">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="主机名" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtHostname" Grid.Column="1" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="1" Text="操作系统" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtOS" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="2" Text="用户名" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtUsername" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="3" Text=".NET 版本" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtDotNetVer" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 底部日志条 -->
        <Border Grid.Row="2" Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0"
                Padding="12,6">
            <Grid>
                <TextBox x:Name="TxtLog"
                         IsReadOnly="True" TextWrapping="NoWrap"
                         Background="Transparent" BorderThickness="0"
                         FontFamily="Consolas" FontSize="12"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         VerticalAlignment="Center" Height="24"/>
            </Grid>
        </Border>
    </Grid>
</Window>
