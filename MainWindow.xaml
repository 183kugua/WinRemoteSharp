<Window x:Class="WinRemoteSharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinRemote Agent"
        Width="1040" Height="680"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ====== 左侧导航栏 ====== -->
        <Border Grid.Column="0" Background="{StaticResource BgMediumBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Margin="20,24,20,20">
                    <TextBlock Text="🛡️" FontSize="28"/>
                    <TextBlock Text="WinRemote" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0"/>
                    <TextBlock Text="Agent V1.2" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- 导航按钮 -->
                <StackPanel Grid.Row="1" Margin="12,0">
                    <Button x:Name="NavDashboard" Content="主控台"
                            Style="{StaticResource GhostButton}" FontSize="14"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavDashboard_Click"/>
                    <Button x:Name="NavSettings" Content="设置"
                            Style="{StaticResource GhostButton}" FontSize="14"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavSettings_Click"/>
                    <Button x:Name="NavService" Content="系统服务"
                            Style="{StaticResource GhostButton}" FontSize="14"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavService_Click"/>
                    <Button x:Name="NavLogs" Content="运行日志"
                            Style="{StaticResource GhostButton}" FontSize="14"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavLogs_Click"/>
                    <Button x:Name="NavToolbox" Content="工具箱"
                            Style="{StaticResource GhostButton}" FontSize="14"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="NavToolbox_Click"/>
                </StackPanel>

                <!-- 底部状态 -->
                <StackPanel Grid.Row="2" Margin="16,0,16,16">
                    <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,0,0,12"/>
                    <Grid>
                        <Ellipse x:Name="StatusDot" Width="8" Height="8"
                                 Fill="{StaticResource TextMutedBrush}"
                                 HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="未连接"
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   Margin="16,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ====== 右侧内容区 ====== -->
        <Border Grid.Column="1" Background="{StaticResource BgDarkBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 隐藏的旧 TabControl，保留以便 .cs 引用兼容 -->
                <TabControl x:Name="MainTabControl" Visibility="Collapsed"/>

                <!-- 页面标题栏 -->
                <Border Grid.Row="0" Padding="24,16" Background="{StaticResource BgDarkBrush}">
                    <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                            Padding="0,0,0,12">
                        <Grid>
                            <TextBlock x:Name="PageTitle" Text="📊 主控台"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button x:Name="BtnConnect" Content="🔗 连接"
                                        Style="{StaticResource AccentButton}"
                                        Width="90" Margin="0,0,8,0" Click="BtnConnect_Click"/>
                                <Button x:Name="BtnDisconnect" Content="断开"
                                        Style="{StaticResource DangerButton}"
                                        Width="70" Click="BtnDisconnect_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>

                <!-- 内容滚动区 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
                    <StackPanel>

                    <!-- ===== 主控台页面 ===== -->
                    <StackPanel x:Name="PanelDashboard" Visibility="Visible">
                        <!-- 服务器连接卡片 -->
                        <Border Background="{StaticResource BgCardBrush}"
                                CornerRadius="10" Padding="20" Margin="0,0,0,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="服务器地址" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBox x:Name="TxtServerUrl" Grid.Column="1"
                                         Text="ws://127.0.0.1:6190/winremote"/>

                                <TextBlock Grid.Row="2" Text="认证 Token" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                <PasswordBox x:Name="TxtToken" Grid.Row="2" Grid.Column="1"/>

                                <TextBlock Grid.Row="4" Text="Agent ID" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBox x:Name="TxtAgentId" Grid.Row="4" Grid.Column="1"
                                         IsReadOnly="True" Background="{StaticResource BgDarkBrush}"
                                         Foreground="{StaticResource TextMutedBrush}"/>

                                <WrapPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                    <Button Content="🧪 测试连接" Style="{StaticResource SecondaryButton}"
                                            Click="BtnSendTest_Click" Width="110" Margin="0,0,8,0"/>
                                    <Button Content="💾 保存配置" Style="{StaticResource SecondaryButton}"
                                            Click="BtnSaveConfig_Click" Width="110"/>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- 快速操作卡片 -->
                        <Border Background="{StaticResource BgCardBrush}"
                                CornerRadius="10" Padding="20" Margin="0,0,0,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="快速操作" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                <WrapPanel>
                                    <Button Content="CMD" Style="{StaticResource SecondaryButton}"
                                            Click="BtnShell_Click" Width="95" Margin="0,0,8,8"/>
                                    <Button Content="PowerShell" Style="{StaticResource SecondaryButton}"
                                            Click="BtnPowershell_Click" Width="130" Margin="0,0,8,8"/>
                                    <Button Content="截图" Style="{StaticResource SecondaryButton}"
                                            Click="BtnScreenshot_Click" Width="90" Margin="0,0,8,8"/>
                                    <Button Content="按键" Style="{StaticResource SecondaryButton}"
                                            Click="BtnKeypress_Click" Width="90" Margin="0,0,8,8"/>
                                    <Button Content="鼠标" Style="{StaticResource SecondaryButton}"
                                            Click="BtnMouse_Click" Width="90" Margin="0,0,8,8"/>
                                    <Button Content="打开" Style="{StaticResource SecondaryButton}"
                                            Click="BtnOpen_Click" Width="90" Margin="0,0,8,8"/>
                                    <Button Content="读文件" Style="{StaticResource SecondaryButton}"
                                            Click="BtnReadFile_Click" Width="100" Margin="0,0,8,8"/>
                                    <Button Content="写文件" Style="{StaticResource SecondaryButton}"
                                            Click="BtnWriteFile_Click" Width="100"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- 命令测试卡片 -->
                        <Border Background="{StaticResource BgCardBrush}"
                                CornerRadius="10" Padding="20"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="命令测试" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtTestCommand" Text="ipconfig"/>
                                    <Button Grid.Column="1" Content="▶ 执行"
                                            Style="{StaticResource AccentButton}"
                                            Click="BtnRunTestCommand_Click" Width="80" Margin="8,0,0,0"/>
                                </Grid>
                                <TextBox x:Name="TxtTestResult" Height="140" Margin="0,10,0,0"
                                         IsReadOnly="True" TextWrapping="Wrap"
                                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         Background="{StaticResource BgDarkBrush}"
                                         Foreground="{StaticResource TextSecondaryBrush}"
                                         BorderBrush="{StaticResource BorderSubtleBrush}"
                                         FontFamily="Consolas" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== 设置页面 ===== -->
                    <StackPanel x:Name="PanelSettings" Visibility="Collapsed">
                        <Border Background="{StaticResource BgCardBrush}"
                                CornerRadius="10" Padding="20" Margin="0,0,0,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="安全设置" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                <CheckBox x:Name="ChkAllowPowershell" Content="允许 PowerShell 指令"/>
                                <CheckBox x:Name="ChkAllowWrite" Content="允许文件写入"/>
                                <CheckBox x:Name="ChkAutoReconnect" Content="断线自动重连"/>
                                <CheckBox x:Name="ChkStrictWhitelist" Content="严格路径白名单模式"/>
                                <CheckBox x:Name="ChkPasswordGuard" Content="启用二次密码验证"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource BgCardBrush}"
                                CornerRadius="10" Padding="20" Margin="0,0,0,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="白名单 &amp; 黑名单" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                <TextBlock Text="文件读取白名单（每行一个路径）" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtWhitelist" Height="80" AcceptsReturn="True"
                                         TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <TextBlock Text="禁止关键词（每行一个）" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtBlacklist" Height="50" AcceptsReturn="True"
                                         TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource BgCardBrush}"
                                CornerRadius="10" Padding="20" Margin="0,0,0,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="高级选项" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="心跳间隔 (秒)" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                    <TextBox x:Name="TxtHeartbeat" Grid.Column="1" Text="30" Width="80" HorizontalAlignment="Left"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Shell 超时 (秒)" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                    <TextBox x:Name="TxtShellTimeout" Grid.Column="1" Text="30" Width="80" HorizontalAlignment="Left"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="最大输出字节" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                    <TextBox x:Name="TxtMaxOutput" Grid.Column="1" Text="65536" Width="120" HorizontalAlignment="Left"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="截图质量 (1-100)" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                    <TextBox x:Name="TxtScreenshotQuality" Grid.Column="1" Text="80" Width="80" HorizontalAlignment="Left"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="截图格式" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                    <ComboBox x:Name="CmbScreenshotFmt" Grid.Column="1" Width="120" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="JPEG"/>
                                        <ComboBoxItem Content="PNG"/>
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="最大读文件字节" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                    <TextBox x:Name="TxtMaxReadBytes" Grid.Column="1" Text="1048576" Width="120" HorizontalAlignment="Left"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="保护密码" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                    <PasswordBox x:Name="TxtPasswordGuard" Grid.Column="1" Width="200" HorizontalAlignment="Left"/>
                                </Grid>
                                <Button Content="💾 保存设置" Style="{StaticResource AccentButton}"
                                        Click="BtnSaveConfig_Click" Width="130" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== 系统服务页面 ===== -->
                    <StackPanel x:Name="PanelService" Visibility="Collapsed">
                        <Border Background="{StaticResource BgCardBrush}"
                                CornerRadius="10" Padding="20" Margin="0,0,0,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="服务状态" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="ServiceDot" Width="10" Height="10"
                                             Fill="{StaticResource TextMutedBrush}" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="ServiceStatusText" Grid.Column="1"
                                               Text="未知" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Grid>
                                <TextBlock x:Name="NssmStatusText" Text="NSSM：检测中..."
                                           FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource BgCardBrush}"
                                CornerRadius="10" Padding="20" Margin="0,0,0,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="服务操作" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                <WrapPanel>
                                    <Button Content="安装服务" Style="{StaticResource PrimaryButton}"
                                            Click="BtnSvcInstall_Click" Width="100" Margin="0,0,8,8"/>
                                    <Button Content="卸载服务" Style="{StaticResource DangerButton}"
                                            Click="BtnSvcUninstall_Click" Width="100" Margin="0,0,8,8"/>
                                    <Button Content="启动" Style="{StaticResource SecondaryButton}"
                                            Click="BtnSvcStart_Click" Width="70" Margin="0,0,8,8"/>
                                    <Button Content="停止" Style="{StaticResource SecondaryButton}"
                                            Click="BtnSvcStop_Click" Width="70" Margin="0,0,8,8"/>
                                    <Button Content="重启" Style="{StaticResource SecondaryButton}"
                                            Click="BtnSvcRestart_Click" Width="70" Margin="0,0,8,8"/>
                                    <Button Content="下载 NSSM" Style="{StaticResource SecondaryButton}"
                                            Click="BtnDownloadNssm_Click" Width="110"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource BgCardBrush}"
                                CornerRadius="10" Padding="20"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="服务日志" FontWeight="SemiBold" FontSize="14"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="刷新" Style="{StaticResource SecondaryButton}"
                                                Click="BtnViewLogs_Click" Width="60" Padding="8,4" FontSize="11"
                                                Margin="0,0,6,0"/>
                                        <Button Content="清除" Style="{StaticResource GhostButton}"
                                                Click="BtnClearServiceLog_Click" Width="50" Padding="8,4" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                                <TextBox x:Name="TxtServiceLog" Height="140" Margin="0,10,0,0"
                                         IsReadOnly="True" TextWrapping="Wrap"
                                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         Background="{StaticResource BgDarkBrush}"
                                         Foreground="{StaticResource TextSecondaryBrush}"
                                         BorderBrush="{StaticResource BorderSubtleBrush}"
                                         FontFamily="Consolas" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== 运行日志页面 ===== -->
                    <StackPanel x:Name="PanelLogs" Visibility="Collapsed">
                        <Border Background="{StaticResource BgCardBrush}"
                                CornerRadius="10" Padding="20"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="完整日志" FontWeight="SemiBold" FontSize="14"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="刷新" Style="{StaticResource SecondaryButton}"
                                                Click="BtnRefreshLog_Click" Width="60" Padding="8,4" FontSize="11"
                                                Margin="0,0,6,0"/>
                                        <Button Content="清空" Style="{StaticResource GhostButton}"
                                                Click="BtnClearLog_Click" Width="50" Padding="8,4" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                                <TextBox x:Name="TxtFullLog" Grid.Row="1" Height="400"
                                         IsReadOnly="True" TextWrapping="Wrap"
                                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         Background="{StaticResource BgDarkBrush}"
                                         Foreground="{StaticResource TextSecondaryBrush}"
                                         BorderBrush="{StaticResource BorderSubtleBrush}"
                                         FontFamily="Consolas" FontSize="12"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ===== 工具箱页面 ===== -->
                    <StackPanel x:Name="PanelToolbox" Visibility="Collapsed">
                        <Border Background="{StaticResource BgCardBrush}"
                                CornerRadius="10" Padding="20"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="系统信息" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="主机名" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="TxtHostname" Grid.Column="1"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="操作系统" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="TxtOS" Grid.Column="1"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="用户名" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="TxtUsername" Grid.Column="1"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text=".NET 版本" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="TxtDotNetVer" Grid.Column="1"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 底部状态栏 -->
                <Border Grid.Row="2" Background="{StaticResource BgMediumBrush}"
                        Padding="16,8" BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="0,1,0,0">
                    <TextBox x:Name="TxtLog"
                             IsReadOnly="True" TextWrapping="NoWrap"
                             Background="Transparent" BorderThickness="0"
                             FontFamily="Consolas" FontSize="11"
                             Foreground="{StaticResource TextMutedBrush}"
                             VerticalAlignment="Center" Height="20"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
