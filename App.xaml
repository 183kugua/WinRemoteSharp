<Application x:Class="WinRemoteSharp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- ========== 薄荷天蓝清新配色 ========== -->
        <!-- 基础色板 -->
        <Color x:Key="MintWhite">#FFF5FAFA</Color>        <!-- 主背景：极浅薄荷白 -->
        <Color x:Key="MintCream">#FFE8F6F0</Color>        <!-- 次背景：薄荷奶油 -->
        <Color x:Key="MintLight">#FFD0EDDD</Color>        <!-- 浅薄荷 -->
        <Color x:Key="MintSoft">#FFB2DFCA</Color>         <!-- 柔和薄荷 -->
        <Color x:Key="MintMain">#FF6CC9A8</Color>         <!-- 主薄荷 -->
        <Color x:Key="MintDeep">#FF3AAF8A</Color>         <!-- 深薄荷 -->
        <Color x:Key="MintDark">#FF278A6E</Color>         <!-- 墨薄荷 -->

        <Color x:Key="SkyWhite">#FFF0F8FF</Color>         <!-- 天蓝白 -->
        <Color x:Key="SkyLight">#FFD6ECFA</Color>         <!-- 浅天蓝 -->
        <Color x:Key="SkyMain">#FF7EC8E3</Color>          <!-- 主天蓝 -->
        <Color x:Key="SkyDeep">#FF4AAED0</Color>          <!-- 深天蓝 -->
        <Color x:Key="SkyDark">#FF2E8DB0</Color>          <!-- 墨天蓝 -->

        <Color x:Key="TextDark">#FF1A3A33</Color>          <!-- 主文字：深墨绿 -->
        <Color x:Key="TextMid">#FF3D6B5E</Color>          <!-- 次文字 -->
        <Color x:Key="TextMuted">#FF6B9E90</Color>         <!-- 弱文字 -->
        <Color x:Key="TextOnMint">#FFFFFFFF</Color>        <!-- 薄荷上的白字 -->

        <Color x:Key="AccentPeach">#FFFFB088</Color>       <!-- 暖桃：警告/强调 -->
        <Color x:Key="AccentCoral">#FFEE6B6B</Color>       <!-- 珊瑚：错误 -->
        <Color x:Key="AccentLemon">#FFF4D35E</Color>       <!-- 柠檬：提示 -->
        <Color x:Key="AccentLavender">#FFB8A9E6</Color>    <!-- 薰衣草：装饰 -->

        <Color x:Key="SuccessGreen">#FF2E9D6E</Color>      <!-- 成功绿 -->
        <Color x:Key="WarnOrange">#FFF5A623</Color>        <!-- 警告橙 -->
        <Color x:Key="ErrorRed">#FFE04848</Color>          <!-- 错误红 -->
        <Color x:Key="InfoBlue">#FF4AAED0</Color>          <!-- 信息蓝 -->

        <!-- 刷子 -->
        <SolidColorBrush x:Key="BgPrimary" Color="{StaticResource MintWhite}"/>
        <SolidColorBrush x:Key="BgSecondary" Color="{StaticResource MintCream}"/>
        <SolidColorBrush x:Key="BgCard" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="BgSidebar" Color="{StaticResource MintCream}"/>
        <SolidColorBrush x:Key="BgHeader" Color="{StaticResource MintMain}"/>
        <SolidColorBrush x:Key="BgTabActive" Color="{StaticResource MintDeep}"/>
        <SolidColorBrush x:Key="BgTabInactive" Color="Transparent"/>
        <SolidColorBrush x:Key="BgInput" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="BgLog" Color="#FFFAFDFB"/>
        <SolidColorBrush x:Key="BgStatus" Color="{StaticResource SkyDeep}"/>

        <SolidColorBrush x:Key="FgPrimary" Color="{StaticResource TextDark}"/>
        <SolidColorBrush x:Key="FgSecondary" Color="{StaticResource TextMid}"/>
        <SolidColorBrush x:Key="FgMuted" Color="{StaticResource TextMuted}"/>
        <SolidColorBrush x:Key="FgOnMint" Color="{StaticResource TextOnMint}"/>
        <SolidColorBrush x:Key="FgLink" Color="{StaticResource SkyDark}"/>

        <SolidColorBrush x:Key="BorderSoft" Color="{StaticResource MintLight}"/>
        <SolidColorBrush x:Key="BorderFocus" Color="{StaticResource MintMain}"/>
        <SolidColorBrush x:Key="BorderInput" Color="{StaticResource MintSoft}"/>

        <SolidColorBrush x:Key="Accent" Color="{StaticResource MintMain}"/>
        <SolidColorBrush x:Key="AccentDeep" Color="{StaticResource MintDeep}"/>
        <SolidColorBrush x:Key="AccentSky" Color="{StaticResource SkyMain}"/>
        <SolidColorBrush x:Key="AccentSkyDeep" Color="{StaticResource SkyDeep}"/>

        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessGreen}"/>
        <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnOrange}"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorRed}"/>
        <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoBlue}"/>

        <!-- 全局默认字体 -->
        <FontFamily x:Key="UiFont">Segoe UI</FontFamily>

        <!-- 全局样式 -->
        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource BgPrimary}"/>
            <Setter Property="Foreground" Value="{StaticResource FgPrimary}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        </Style>

        <!-- 标题栏 -->
        <Style x:Key="HeaderBar" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgHeader}"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>

        <!-- 卡片 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.08" Color="#88B2DFCA"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MintDark}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- TabControl 清新风 -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource FgSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Background" Value="{StaticResource BgTabInactive}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderSoft}"
                                BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6,6,0,0"
                                Margin="2,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgTabActive}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource MintMain}"/>
                                <Setter Property="Foreground" Value="{StaticResource FgOnMint}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MintLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮：薄荷绿 -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource MintMain}"/>
            <Setter Property="Foreground" Value="{StaticResource FgOnMint}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MintDeep}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MintDark}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MintSoft}"/>
                                <Setter Property="Foreground" Value="{StaticResource FgMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次按钮：天蓝 -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SkyMain}"/>
            <Setter Property="Foreground" Value="{StaticResource FgOnMint}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SkyDeep}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SkyDark}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SkyLight}"/>
                                <Setter Property="Foreground" Value="{StaticResource FgMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 危险按钮：珊瑚 -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentCoral}"/>
            <Setter Property="Foreground" Value="{StaticResource FgOnMint}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFD94F4F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFC0392B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 幽灵按钮：薄荷描边 -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MintDark}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderBrush" Value="{StaticResource MintMain}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MintCream}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MintLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 输入框 -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground" Value="{StaticResource FgPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderInput}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderFocus}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground" Value="{StaticResource FgPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderInput}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- CheckBox 薄荷风 -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource FgPrimary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="18" Height="18"
                                    Background="{StaticResource BgInput}"
                                    BorderBrush="{StaticResource MintMain}"
                                    BorderThickness="1.5"
                                    CornerRadius="4"
                                    VerticalAlignment="Center">
                                <Path x:Name="Check" Data="M 3,9 L 7,13 L 14,4"
                                      Stroke="{StaticResource FgOnMint}"
                                      StrokeThickness="2.5"
                                      Visibility="Collapsed"
                                      StrokeEndLineCap="Round"
                                      StrokeStartLineCap="Round"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource MintMain}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource MintDeep}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground" Value="{StaticResource FgPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderInput}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <!-- 进度条 -->
        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource MintMain}"/>
            <Setter Property="Background" Value="{StaticResource MintCream}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <Grid>
                                <Border x:Name="PART_Indicator"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="3"
                                        HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 状态指示灯 -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Stroke" Value="#55FFFFFF"/>
            <Setter Property="StrokeThickness" Value="1"/>
        </Style>

        <!-- 分隔线 -->
        <Style x:Key="SoftSeparator" TargetType="Separator">
            <Setter Property="Background" Value="{StaticResource MintLight}"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="Height" Value="1"/>
        </Style>

        <!-- 标签（小徽章） -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MintLight}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>

        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MintDark}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- 滚动条清新风 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Rectangle Fill="{StaticResource MintCream}" RadiusX="5" RadiusY="5"/>
                            <Track Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Rectangle Fill="{StaticResource MintSoft}" RadiusX="5" RadiusY="5"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 状态栏 -->
        <Style x:Key="StatusBar" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SkyDeep}"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>

        <!-- 状态栏文字 -->
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FgOnMint}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- 日志级别颜色 -->
        <Style x:Key="LogInfo" TargetType="Run">
            <Setter Property="Foreground" Value="{StaticResource SkyDark}"/>
        </Style>
        <Style x:Key="LogOk" TargetType="Run">
            <Setter Property="Foreground" Value="{StaticResource SuccessGreen}"/>
        </Style>
        <Style x:Key="LogWarn" TargetType="Run">
            <Setter Property="Foreground" Value="{StaticResource WarnOrange}"/>
        </Style>
        <Style x:Key="LogError" TargetType="Run">
            <Setter Property="Foreground" Value="{StaticResource ErrorRed}"/>
        </Style>
        <Style x:Key="LogDebug" TargetType="Run">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>
    </Application.Resources>
</Application>
