<Application x:Class="WinRemoteSharp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ========== 薄荷天蓝清新配色 ========== -->

        <!-- 基础颜色 -->
        <Color x:Key="MintWhite">#FFF5FAFA</Color>
        <Color x:Key="MintCream">#FFE8F6F0</Color>
        <Color x:Key="MintMain">#FF6CC9A8</Color>
        <Color x:Key="MintDeep">#FF3AAF8A</Color>
        <Color x:Key="SkyMain">#FF7EC8E3</Color>
        <Color x:Key="SkyDeep">#FF4AAED0</Color>
        <Color x:Key="AccentPeach">#FFFFB088</Color>
        <Color x:Key="AccentCoral">#FFEE6B6B</Color>
        <Color x:Key="AccentLemon">#FFF4D35E</Color>
        <Color x:Key="AccentLavender">#FFB8A9E6</Color>
        <Color x:Key="SuccessGreen">#FF2ECC71</Color>
        <Color x:Key="WarnOrange">#FFF5A623</Color>
        <Color x:Key="ErrorRed">#FFE04848</Color>
        <Color x:Key="TextDark">#FF1A3A33</Color>
        <Color x:Key="TextMuted">#FF6B8E85</Color>
        <Color x:Key="CardBorder">#FFB8E0D0</Color>

        <!-- 动画资源 -->
        <Storyboard x:Key="ButtonScaleUp">
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                           To="1.05" Duration="0:0:0.1"/>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                           To="1.05" Duration="0:0:0.1"/>
        </Storyboard>
        
        <Storyboard x:Key="ButtonScaleDown">
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                           To="1.0" Duration="0:0:0.1"/>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                           To="1.0" Duration="0:0:0.1"/>
        </Storyboard>
        
        <Storyboard x:Key="TextBoxGlowIn">
            <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                           To="{StaticResource MintMain}" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetProperty="(Border.BorderThickness).(Thickness.Left)"
                           To="2" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetProperty="(Border.BorderThickness).(Thickness.Top)"
                           To="2" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetProperty="(Border.BorderThickness).(Thickness.Right)"
                           To="2" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetProperty="(Border.BorderThickness).(Thickness.Bottom)"
                           To="2" Duration="0:0:0.2"/>
        </Storyboard>
        
        <Storyboard x:Key="TextBoxGlowOut">
            <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                           To="{StaticResource CardBorder}" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetProperty="(Border.BorderThickness).(Thickness.Left)"
                           To="1.5" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetProperty="(Border.BorderThickness).(Thickness.Top)"
                           To="1.5" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetProperty="(Border.BorderThickness).(Thickness.Right)"
                           To="1.5" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetProperty="(Border.BorderThickness).(Thickness.Bottom)"
                           To="1.5" Duration="0:0:0.2"/>
        </Storyboard>

        <Storyboard x:Key="StatusDotPulse" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(Ellipse.Width)"
                                         RepeatBehavior="Forever">
                <DiscreteDoubleKeyFrame KeyTime="0" Value="12"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="14"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="12"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(Ellipse.Height)"
                                         RepeatBehavior="Forever">
                <DiscreteDoubleKeyFrame KeyTime="0" Value="12"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="14"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="12"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- 新增：TabItem 淡入滑入动画 -->
        <Storyboard x:Key="TabContentFadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.25"/>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                           From="10" To="0" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- 新增：面板滑入动画 -->
        <Storyboard x:Key="PanelSlideIn">
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                           From="-20" To="0" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>

        <!-- 新增：面板滑出动画 -->
        <Storyboard x:Key="PanelSlideOut">
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                           From="0" To="20" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                           From="1" To="0" Duration="0:0:0.2"/>
        </Storyboard>

        <!-- 新增：加载转圈动画 -->
        <Storyboard x:Key="LoadingSpin" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(RotateTransform.Angle)"
                           From="0" To="360" Duration="0:0:1"/>
        </Storyboard>

        <!-- 新增：窗口入场动画 -->
        <Storyboard x:Key="WindowEntrance">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                           From="20" To="0" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- 新增：GroupBox 标题展开动画 -->
        <Storyboard x:Key="GroupBoxExpand">
            <DoubleAnimation Storyboard.TargetProperty="Height"
                           From="0" To="Auto" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- 新增：进度条平滑动画 -->
        <Storyboard x:Key="ProgressBarSmooth">
            <DoubleAnimation Storyboard.TargetProperty="Value"
                           Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- 新增：悬浮卡片上浮动画 -->
        <Storyboard x:Key="CardHoverUp">
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                           From="0" To="-4" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetProperty="Effect.(DropShadowEffect.BlurRadius)"
                           From="8" To="20" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetProperty="Effect.(DropShadowEffect.ShadowDepth)"
                           From="2" To="6" Duration="0:0:0.2"/>
        </Storyboard>

        <Storyboard x:Key="CardHoverDown">
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                           From="-4" To="0" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetProperty="Effect.(DropShadowEffect.BlurRadius)"
                           From="20" To="8" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetProperty="Effect.(DropShadowEffect.ShadowDepth)"
                           From="6" To="2" Duration="0:0:0.2"/>
        </Storyboard>

        <!-- 新增：列表项交错入场动画 -->
        <Storyboard x:Key="ListItemStaggerIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.3"/>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                           From="-30" To="0" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- 画刷 -->
        <SolidColorBrush x:Key="MintWhiteBrush" Color="{StaticResource MintWhite}"/>
        <SolidColorBrush x:Key="MintCreamBrush" Color="{StaticResource MintCream}"/>
        <SolidColorBrush x:Key="MintMainBrush" Color="{StaticResource MintMain}"/>
        <SolidColorBrush x:Key="MintDeepBrush" Color="{StaticResource MintDeep}"/>
        <SolidColorBrush x:Key="SkyMainBrush" Color="{StaticResource SkyMain}"/>
        <SolidColorBrush x:Key="SkyDeepBrush" Color="{StaticResource SkyDeep}"/>
        <SolidColorBrush x:Key="AccentPeachBrush" Color="{StaticResource AccentPeach}"/>
        <SolidColorBrush x:Key="AccentCoralBrush" Color="{StaticResource AccentCoral}"/>
        <SolidColorBrush x:Key="AccentLemonBrush" Color="{StaticResource AccentLemon}"/>
        <SolidColorBrush x:Key="AccentLavenderBrush" Color="{StaticResource AccentLavender}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessGreen}"/>
        <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnOrange}"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorRed}"/>
        <SolidColorBrush x:Key="TextDarkBrush" Color="{StaticResource TextDark}"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>
        
        <!-- 状态指示画刷 -->
        <SolidColorBrush x:Key="StatusOnlineBrush" Color="{StaticResource SuccessGreen}"/>
        <SolidColorBrush x:Key="StatusOfflineBrush" Color="{StaticResource ErrorRed}"/>
        <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource SuccessGreen}"/>
        <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource ErrorRed}"/>
        
        <!-- 输入框对话框资源 -->
        <SolidColorBrush x:Key="BgLightBrush" Color="{StaticResource MintWhite}"/>
        <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource MintWhite}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextDark}"/>
        <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource CardBorder}"/>
        <SolidColorBrush x:Key="TextLightBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextMuted}"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorder}"/>

        <!-- 标题栏渐变 -->
        <LinearGradientBrush x:Key="TitleBarBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="{StaticResource MintMain}" Offset="0"/>
            <GradientStop Color="{StaticResource SkyDeep}" Offset="1"/>
        </LinearGradientBrush>

        <!-- ========== 全局样式 ========== -->

        <!-- 默认窗口背景 -->
        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource MintWhiteBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform X="0" Y="0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard Storyboard="{StaticResource WindowEntrance}"/>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- 按钮基础样式 (增强版) -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource MintMainBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                        <SkewTransform AngleX="0" AngleY="0"/>
                        <RotateTransform Angle="0"/>
                        <TranslateTransform X="0" Y="0"/>
                    </TransformGroup>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="Content" 
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource ButtonScaleDown}"/>
                                </Trigger.ExitActions>
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource ButtonScaleUp}"/>
                                </Trigger.EnterActions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MintDeepBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource ButtonScaleDown}"/>
                                </Trigger.EnterActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次按钮 -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource SkyMainBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SkyDeepBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 危险按钮 -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentCoralBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFD63031"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 文本框 (增强版) -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{StaticResource MintDeepBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource TextBoxGlowIn}"/>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource TextBoxGlowOut}"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 密码框 (增强版) -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{StaticResource MintDeepBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource TextBoxGlowIn}"/>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource TextBoxGlowOut}"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉框 (增强版) -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton" 
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Focusable="False"
                                              ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Path x:Name="Arrow" Fill="{StaticResource TextMutedBrush}" 
                                          Data="M 0 0 L 4 4 L 8 0 Z" 
                                          VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                </ToggleButton>
                                <ContentPresenter x:Name="ContentSite" 
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Margin="10,0,30,0"
                                                  IsHitTestVisible="False"/>
                                <Popup x:Name="Popup" 
                                       AllowsTransparency="True" 
                                       Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}">
                                    <Border x:Name="DropDownBorder" Background="White"
                                            BorderBrush="{StaticResource MintMainBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="6"
                                            MaxHeight="200"
                                            MinWidth="{TemplateBinding ActualWidth}"
                                            Effect="{StaticResource {x:Static SystemParameters.DropShadowKey}}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource TextBoxGlowIn}"/>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource TextBoxGlowOut}"/>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180" CenterX="4" CenterY="2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MintCreamBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MintMainBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 进度条 (增强版) -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="{StaticResource MintCreamBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource MintMainBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border x:Name="Track" Background="{TemplateBinding Background}"
                                CornerRadius="3" SnapsToDevicePixels="True">
                            <Grid x:Name="PART_Indicator" ClipToBounds="True">
                                <Border x:Name="Indicator" Background="{TemplateBinding Foreground}"
                                        CornerRadius="3" HorizontalAlignment="Left">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 悬浮卡片 Border 样式 -->
        <Style x:Key="HoverCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform X="0" Y="0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="#20000000" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard Storyboard="{StaticResource CardHoverUp}"/>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard Storyboard="{StaticResource CardHoverDown}"/>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 列表项容器 -->
        <Style x:Key="AnimatedListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform X="0" Y="0"/>
                            </Border.RenderTransform>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MintCreamBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MintCreamBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标签 -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="0,2"/>
        </Style>

        <!-- 复选框 -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <!-- TabControl (增强版：内容切换动画) -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" x:Name="HeaderPanel"
                                      Panel.ZIndex="1"
                                      Margin="0,0,4,-1"
                                      IsItemsHost="True"
                                      KeyboardNavigation.TabIndex="1"/>
                            <Border Grid.Row="1" x:Name="ContentPanel"
                                    Background="Transparent"
                                    KeyboardNavigation.TabIndex="2"
                                    KeyboardNavigation.DirectionalNavigation="Contained">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  Margin="0,8,0,0">
                                    <ContentPresenter.RenderTransform>
                                        <TranslateTransform X="0" Y="0"/>
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabItem (增强版) -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource MintMainBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource MintDeepBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource TabContentFadeIn}"/>
                                </Trigger.EnterActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MintCreamBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- GroupBox (增强版：内容滑入动画) -->
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border x:Name="OuterBorder" Background="White"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Padding="10,6" Background="{StaticResource MintCreamBrush}" CornerRadius="10,10,0,0">
                                    <ContentPresenter ContentSource="Header" TextElement.FontWeight="SemiBold"
                                                      TextElement.Foreground="{StaticResource MintDeepBrush}"/>
                                </Border>
                                <Border Grid.Row="1" x:Name="ContentBorder" Margin="{TemplateBinding Padding}">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="0" Y="0"/>
                                    </Border.RenderTransform>
                                    <ContentPresenter/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ContentBorder"
                                                       Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                       From="-20" To="0" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ContentBorder"
                                                       Storyboard.TargetProperty="Opacity"
                                                       From="0" To="1" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBlock -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
        </Style>

        <!-- ListBox -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
        </Style>

        <!-- ScrollViewer -->
        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

    </Application.Resources>
</Application>
